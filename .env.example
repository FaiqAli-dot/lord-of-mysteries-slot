# Vite base path for GitHub Pages project site (CI/Pages set this automatically).
# VITE_BASE=/lord-of-mysteries-slot/

# Optional build-time default API (leave unset for fully client-side Pages).
# Overridable at runtime via ?api= or Settings.
# VITE_API_BASE=https://pathways-of-the-sealed-api.fly.dev

# Server (optional)
PORT=8787
# Comma-separated extra CORS origins (Pages + localhost are always included)
# CORS_ORIGINS=https://example.com
